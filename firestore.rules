rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /games/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    match /scores/{scoreId} {
      allow read: if true;
      allow delete: if false;

      allow create: if isValidScore(request.resource.data);
      allow update: if isValidScore(request.resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.date == resource.data.date;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow update, delete: if false;

      allow create: if isValidComment(request.resource.data);
    }
  }
}

function isValidScore(data) {
  return data.keys().hasAll(['userId', 'gameId', 'score', 'date'])
    && data.userId is string
    && data.gameId is string
    && data.score is string
    && data.score.size() > 0
    && data.score.size() <= 5000
    && data.date is string
    && data.date.matches('^\\d{8}$');
}

function isValidComment(data) {
  return data.keys().hasOnly(['scoreId', 'userId', 'text', 'createdAt'])
    && data.keys().hasAll(['scoreId', 'userId', 'text', 'createdAt'])
    && data.scoreId is string
    && data.scoreId.size() > 0
    && data.scoreId.size() <= 500
    && data.userId is string
    && data.userId.size() > 0
    && data.text is string
    && data.text.size() > 0
    && data.text.size() <= 500
    && data.createdAt == request.time;
}
